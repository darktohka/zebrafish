From: Buildroot <buildroot@buildroot.org>
Date: Sun, 5 Jan 2026 00:00:00 +0000
Subject: [PATCH] Fix missing kernel type includes for size_t and bool

The iomemory-vsl4 driver defines its own versions of the fixed-width
integer types (int64_t/uint64_t) and uses bool/size_t without always
including the proper kernel headers.  On 64-bit kernels u64/s64 are
`unsigned long long`/`long long` while the driver's userspace-style
typedefs use `unsigned long`/`long`, so including both the driver shim
and <linux/types.h> in the same translation unit makes GCC complain
about conflicting types for bool, int64_t and uint64_t.

Include <linux/types.h> from the portability stdint.h shim when building
against the kernel, so the kernel's own definitions are used and the
shim's userspace typedefs are skipped.  Also include <linux/types.h>
where the driver's own headers rely on those types, fixing compilation
with newer kernels.

Signed-off-by: Buildroot <buildroot@buildroot.org>
---
 root/usr/src/iomemory-vsl4-4.3.7/include/fio/port/common-linux/stdint.h | 4 ++++
 root/usr/src/iomemory-vsl4-4.3.7/include/fio/port/kmem.h                | 1 +
 root/usr/src/iomemory-vsl4-4.3.7/include/fio/port/six_lock.h            | 1 +
 root/usr/src/iomemory-vsl4-4.3.7/six_lock.c                             | 1 +
 4 files changed, 7 insertions(+)

diff --git a/root/usr/src/iomemory-vsl4-4.3.7/include/fio/port/common-linux/stdint.h b/root/usr/src/iomemory-vsl4-4.3.7/include/fio/port/common-linux/stdint.h
index 514ca4f..749e92b 100644
--- a/root/usr/src/iomemory-vsl4-4.3.7/include/fio/port/common-linux/stdint.h
+++ b/root/usr/src/iomemory-vsl4-4.3.7/include/fio/port/common-linux/stdint.h
@@ -34,6 +34,10 @@
  * @ingroup PORT_COMMON_LINUX
  * @{
  */
+#ifdef __KERNEL__
+#include <linux/types.h>
+#endif
+
 #ifndef _LINUX_TYPES_H
 
 /* Exact integral types.  */
diff --git a/root/usr/src/iomemory-vsl4-4.3.7/include/fio/port/kmem.h b/root/usr/src/iomemory-vsl4-4.3.7/include/fio/port/kmem.h
index d613371..c850c67 100644
--- a/root/usr/src/iomemory-vsl4-4.3.7/include/fio/port/kmem.h
+++ b/root/usr/src/iomemory-vsl4-4.3.7/include/fio/port/kmem.h
@@ -37,6 +37,7 @@
 #error Please include <fio/port/ktypes.h> rather than this file directly.
 #endif
 #include <fio/port/errno.h>
+#include <linux/types.h>
 #ifndef __FIO_PORT_KMEM_H__
 #define __FIO_PORT_KMEM_H__
 
diff --git a/root/usr/src/iomemory-vsl4-4.3.7/include/fio/port/six_lock.h b/root/usr/src/iomemory-vsl4-4.3.7/include/fio/port/six_lock.h
index 0c7deb3..ba52bf2 100644
--- a/root/usr/src/iomemory-vsl4-4.3.7/include/fio/port/six_lock.h
+++ b/root/usr/src/iomemory-vsl4-4.3.7/include/fio/port/six_lock.h
@@ -39,6 +39,7 @@
 #define __SIX_LOCK_H__
 
 #include <fio/port/types.h>
+#include <linux/types.h>
 
 // BIG WARNING
 // Notation and *order* is taken from Gray and Reuter (1993)
diff --git a/root/usr/src/iomemory-vsl4-4.3.7/six_lock.c b/root/usr/src/iomemory-vsl4-4.3.7/six_lock.c
index 6add2de..2dcfcb3 100644
--- a/root/usr/src/iomemory-vsl4-4.3.7/six_lock.c
+++ b/root/usr/src/iomemory-vsl4-4.3.7/six_lock.c
@@ -42,6 +42,7 @@
 #include <fio/port/six_lock.h>
 #include <fio/port/dbgset.h>
 #include <fio/port/errno.h>
+#include <linux/types.h>
 
 #define FOR_ALL_LOCK_CLASSES(ind)                       \
     for (ind = 0; ind < NUM_SIX_LOCK_CLASSES; ind++)
